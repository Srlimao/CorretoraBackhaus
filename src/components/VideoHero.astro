---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icons from './Icons.astro';
import { getYouTubeInfo } from '../utils/youtube';
import { getStatusBadgeInfo } from '../utils/formatters';

export interface Props {
  title: string;
  tagline: string;
  status: string;
  category: string;
  location: {
    neighborhood: string;
    city: string;
    state: string;
    distanceToBeach?: string;
  };
  youtubeUrl?: string;
  thumbnailImage?: ImageMetadata | null;
}

const {
  title,
  tagline,
  status,
  category,
  location,
  youtubeUrl,
  thumbnailImage,
} = Astro.props;

const ytInfo = getYouTubeInfo(youtubeUrl);
const statusBadge = getStatusBadgeInfo(status);
const hasVideo = !!ytInfo.embedUrl;
---

<div class="relative bg-navy-950 text-white overflow-hidden w-full border-b border-navy-800">
  
  <!-- Video / Media Container -->
  <div class="relative w-full aspect-[16/9] sm:aspect-[21/9] min-h-[440px] max-h-[640px] overflow-hidden bg-navy-950">
    
    {hasVideo ? (
      <div class="absolute inset-0 w-full h-full pointer-events-none scale-105">
        <iframe
          id="hero-youtube-iframe"
          src={ytInfo.embedUrl}
          title={`Vídeo do empreendimento ${title}`}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          class="w-full h-full object-cover border-0"
        />
      </div>
    ) : thumbnailImage ? (
      <div class="absolute inset-0 w-full h-full">
        <Image
          src={thumbnailImage}
          alt={title}
          width={1920}
          height={1080}
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    ) : null}

    <!-- Gradient Darkness Overlay for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/60 to-navy-950/40 pointer-events-none"></div>

    <!-- Content Overlay Box -->
    <div class="absolute inset-0 flex flex-col justify-end p-6 sm:p-10 lg:p-12 z-20">
      <div class="max-w-4xl space-y-4">
        
        <!-- Badges Row -->
        <div class="flex flex-wrap items-center gap-2.5">
          <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider backdrop-blur-md border ${statusBadge.bgClass} ${statusBadge.textClass} ${statusBadge.borderClass} shadow-md`}>
            <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
            <span>{statusBadge.label}</span>
          </span>

          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-navy-800/80 text-slate-200 border border-white/10 backdrop-blur-md">
            <span>{category}</span>
          </span>

          {location.distanceToBeach && (
            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-bold bg-gold-500/20 text-gold-300 border border-gold-500/40 backdrop-blur-md">
              <span>🌊</span>
              <span>{location.distanceToBeach}</span>
            </span>
          )}
        </div>

        <!-- Title & Tagline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-white tracking-tight drop-shadow-md">
          {title}
        </h1>

        <p class="text-base sm:text-lg text-slate-200 font-normal leading-relaxed drop-shadow max-w-2xl">
          {tagline}
        </p>

        <!-- Location Pin -->
        <div class="flex items-center gap-2 text-sm text-gold-400 font-medium drop-shadow">
          <Icons name="map-pin" size={16} />
          <span>{location.neighborhood}, {location.city} - {location.state}</span>
        </div>

      </div>
    </div>

    <!-- Interactive Video Fullscreen / Play Button (if video exists) -->
    {hasVideo && ytInfo.videoId && (
      <div class="absolute top-6 right-6 z-30">
        <a
          href={`https://www.youtube.com/watch?v=${ytInfo.videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-navy-950/80 hover:bg-red-600 border border-white/20 text-white text-xs font-semibold backdrop-blur-md transition-all shadow-lg group"
          title="Assistir no YouTube em 4K"
        >
          <Icons name="play" size={14} class="text-red-500 group-hover:text-white transition-colors" />
          <span>Assistir no YouTube</span>
          <Icons name="external-link" size={12} class="opacity-70" />
        </a>
      </div>
    )}

  </div>
</div>
