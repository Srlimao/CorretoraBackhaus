---
import { Image } from 'astro:assets';
import type { GalleryItem } from '../utils/gallery';
import Icons from './Icons.astro';

export interface Props {
  galleryItems: GalleryItem[];
  propertyTitle: string;
}

const { galleryItems, propertyTitle } = Astro.props;
---

<section id="galeria" class="my-12">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h2 class="text-2xl font-bold font-display text-slate-900">Galeria de Fotos & Plantas</h2>
      <p class="text-slate-500 text-xs sm:text-sm mt-0.5">Clique em qualquer foto para ampliar em alta definição.</p>
    </div>
    <span class="text-xs font-semibold text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg">
      {galleryItems.length} {galleryItems.length === 1 ? 'imagem' : 'imagens'}
    </span>
  </div>

  {galleryItems.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {galleryItems.map((item, index) => (
        <div
          class="gallery-thumbnail-item group relative aspect-[16/11] rounded-2xl overflow-hidden bg-slate-900 cursor-pointer border border-slate-200 hover:border-gold-500/80 shadow-sm hover:shadow-lg transition-all duration-300"
          data-index={index}
          data-src={item.src}
          data-title={item.title}
        >
          <Image
            src={item.image}
            alt={`${item.title} - ${propertyTitle}`}
            width={800}
            height={550}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
          
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
            <div class="flex items-center justify-between w-full text-white">
              <span class="text-xs font-bold font-display tracking-wide">{item.title}</span>
              <span class="p-1.5 rounded-lg bg-white/20 backdrop-blur-sm">
                <Icons name="maximize" size={14} />
              </span>
            </div>
          </div>

          <div class="absolute top-3 left-3 bg-navy-950/70 backdrop-blur-md px-2.5 py-1 rounded-md text-[10px] font-semibold text-slate-300">
            {item.title}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200 text-slate-400 text-sm">
      Galeria de fotos em preparação. Consulte a corretora para receber o book digital.
    </div>
  )}

  <!-- Lightbox Modal -->
  <div id="gallery-lightbox" class="fixed inset-0 z-50 bg-navy-950/95 backdrop-blur-xl hidden flex-col justify-between p-4 sm:p-6 opacity-0 transition-opacity duration-300">
    
    <!-- Header -->
    <div class="flex items-center justify-between text-white z-10">
      <div class="flex items-center gap-3">
        <span id="lightbox-counter" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-white/10 text-gold-400">
          1 / {galleryItems.length}
        </span>
        <span id="lightbox-title" class="text-sm font-semibold font-display text-slate-200">
          Ambiente
        </span>
      </div>

      <button
        type="button"
        id="lightbox-close-btn"
        class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors"
        aria-label="Fechar Galeria"
      >
        <Icons name="close" size={20} />
      </button>
    </div>

    <!-- Main Image Display Container -->
    <div class="relative flex-grow flex items-center justify-center my-4 overflow-hidden">
      <!-- Navigation Prev -->
      <button
        type="button"
        id="lightbox-prev-btn"
        class="absolute left-2 sm:left-6 z-20 p-3 rounded-full bg-navy-900/80 hover:bg-gold-500 hover:text-navy-950 text-white border border-white/10 transition-all shadow-xl"
        aria-label="Foto Anterior"
      >
        <Icons name="chevron-left" size={24} />
      </button>

      <!-- Image -->
      <img
        id="lightbox-img"
        src=""
        alt="Foto ampliada do empreendimento"
        class="max-h-[80vh] max-w-[90vw] object-contain rounded-xl shadow-2xl transition-transform duration-300"
      />

      <!-- Navigation Next -->
      <button
        type="button"
        id="lightbox-next-btn"
        class="absolute right-2 sm:right-6 z-20 p-3 rounded-full bg-navy-900/80 hover:bg-gold-500 hover:text-navy-950 text-white border border-white/10 transition-all shadow-xl"
        aria-label="Próxima Foto"
      >
        <Icons name="chevron-right" size={24} />
      </button>
    </div>

    <!-- Bottom Thumbnail Strip -->
    <div class="flex items-center justify-center gap-2 overflow-x-auto py-2 z-10 max-w-4xl mx-auto scrollbar-none">
      {galleryItems.map((item, index) => (
        <button
          type="button"
          class="lightbox-strip-thumb relative w-16 h-12 rounded-lg overflow-hidden border-2 border-transparent hover:border-gold-400 opacity-60 hover:opacity-100 transition-all flex-shrink-0"
          data-index={index}
        >
          <img src={item.src} alt={item.title} class="w-full h-full object-cover" />
        </button>
      ))}
    </div>

  </div>
</section>

<script>
  function initLightbox() {
    const thumbs = document.querySelectorAll('.gallery-thumbnail-item');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const stripThumbs = document.querySelectorAll('.lightbox-strip-thumb');

    if (!lightbox || !lightboxImg || thumbs.length === 0) return;

    let currentIndex = 0;
    const itemsData: { src: string; title: string }[] = [];

    thumbs.forEach(t => {
      itemsData.push({
        src: t.getAttribute('data-src') || '',
        title: t.getAttribute('data-title') || 'Ambiente',
      });
    });

    function showImage(index: number) {
      if (index < 0) index = itemsData.length - 1;
      if (index >= itemsData.length) index = 0;
      currentIndex = index;

      const item = itemsData[currentIndex];
      if (lightboxImg) lightboxImg.src = item.src;
      if (lightboxTitle) lightboxTitle.textContent = item.title;
      if (lightboxCounter) lightboxCounter.textContent = `${currentIndex + 1} / ${itemsData.length}`;

      // Update active strip thumbnail
      stripThumbs.forEach((st, idx) => {
        if (idx === currentIndex) {
          st.classList.add('border-gold-400', 'opacity-100', 'scale-105');
          st.classList.remove('opacity-60');
        } else {
          st.classList.remove('border-gold-400', 'opacity-100', 'scale-105');
          st.classList.add('opacity-60');
        }
      });
    }

    function openLightbox(index: number) {
      if (!lightbox) return;
      showImage(index);
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      setTimeout(() => {
        lightbox.classList.remove('opacity-0');
      }, 10);
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.add('opacity-0');
      setTimeout(() => {
        lightbox.classList.remove('flex');
        lightbox.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    thumbs.forEach(t => {
      t.addEventListener('click', () => {
        const idx = parseInt(t.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    stripThumbs.forEach(st => {
      st.addEventListener('click', () => {
        const idx = parseInt(st.getAttribute('data-index') || '0', 10);
        showImage(idx);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', () => showImage(currentIndex - 1));
    if (nextBtn) nextBtn.addEventListener('click', () => showImage(currentIndex + 1));

    // Close on click backdrop
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
      if (e.key === 'ArrowRight') showImage(currentIndex + 1);
    });
  }

  document.addEventListener('DOMContentLoaded', initLightbox);
</script>
