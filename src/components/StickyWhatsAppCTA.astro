---
import Icons from './Icons.astro';
import { formatCurrency } from '../utils/formatters';
import { buildWhatsAppUrl } from '../utils/whatsapp';

export interface Props {
  propertyTitle: string;
  propertyCity: string;
  propertyNeighborhood: string;
  priceFrom?: number;
  whatsappNumber?: string;
  deliveryDate?: string;
}

const {
  propertyTitle,
  propertyCity,
  propertyNeighborhood,
  priceFrom,
  whatsappNumber,
  deliveryDate,
} = Astro.props;

const basePath = '/CorretoraBackhaus';

const whatsappInquiryUrl = buildWhatsAppUrl({
  phone: whatsappNumber,
  propertyTitle,
  propertyCity,
  propertyNeighborhood,
  type: 'property',
});

const whatsappVisitUrl = buildWhatsAppUrl({
  phone: whatsappNumber,
  propertyTitle,
  propertyCity,
  propertyNeighborhood,
  type: 'visit',
});

const whatsappPlantsUrl = buildWhatsAppUrl({
  phone: whatsappNumber,
  propertyTitle,
  propertyCity,
  propertyNeighborhood,
  type: 'plants',
});
---

<!-- Desktop Sidebar Conversion Box (Sticky) -->
<aside class="hidden lg:block sticky top-28 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/80 shadow-premium space-y-6">
  
  <!-- Price & Status -->
  <div class="border-b border-slate-100 pb-5">
    <span class="block text-xs font-semibold text-slate-400 uppercase tracking-wider">A partir de</span>
    <div class="text-2xl sm:text-3xl font-bold font-display text-navy-900 mt-0.5">
      {formatCurrency(priceFrom)}
    </div>
    {deliveryDate && (
      <div class="flex items-center gap-1.5 text-xs text-slate-500 font-medium mt-2">
        <Icons name="calendar" size={14} class="text-gold-600" />
        <span>Previsão de entrega: <strong class="text-slate-800">{deliveryDate}</strong></span>
      </div>
    )}
  </div>

  <!-- Broker Profile Badge -->
  <div class="flex items-center gap-3.5 p-3 rounded-2xl bg-slate-50 border border-slate-100">
    <img
      src={`${basePath}/images/catia-backhaus.jpg`}
      alt="Cátia Backhaus"
      class="w-12 h-12 rounded-xl object-cover border border-gold-400/60"
    />
    <div>
      <div class="text-sm font-bold text-slate-900">Cátia Backhaus</div>
      <div class="text-[11px] text-slate-500 font-medium">Corretora Especialista • CRECI/SC</div>
    </div>
  </div>

  <!-- Primary CTAs -->
  <div class="space-y-3">
    
    <!-- WhatsApp Main Button -->
    <a
      href={whatsappInquiryUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-3.5 px-4 rounded-xl bg-whatsapp hover:bg-whatsapp-dark text-white font-bold text-sm text-center shadow-floating hover:shadow-lg transition-all duration-200 flex items-center justify-center gap-2 transform hover:-translate-y-0.5"
    >
      <Icons name="whatsapp" size={18} />
      <span>Consultar Valores & Tabela</span>
    </a>

    <!-- Agendar Visita -->
    <a
      href={whatsappVisitUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-3 px-4 rounded-xl bg-navy-900 hover:bg-navy-800 text-white font-semibold text-xs text-center transition-all duration-200 flex items-center justify-center gap-2"
    >
      <Icons name="calendar" size={15} class="text-gold-400" />
      <span>Agendar Visita Exclusiva</span>
    </a>

    <!-- Solicitar Plantas -->
    <a
      href={whatsappPlantsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full py-2.5 px-4 rounded-xl border border-slate-200 hover:border-slate-300 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs text-center transition-all flex items-center justify-center gap-2"
    >
      <Icons name="maximize" size={14} class="text-slate-500" />
      <span>Solicitar Book de Plantas Humanizadas</span>
    </a>

  </div>

  <!-- Trust guarantees -->
  <div class="pt-2 border-t border-slate-100 space-y-2 text-[11px] text-slate-500">
    <div class="flex items-center gap-2">
      <Icons name="check-circle" size={14} class="text-emerald-600 flex-shrink-0" />
      <span>Atendimento direto com a corretora</span>
    </div>
    <div class="flex items-center gap-2">
      <Icons name="check-circle" size={14} class="text-emerald-600 flex-shrink-0" />
      <span>Negociação com condição de tabela oficial</span>
    </div>
    <div class="flex items-center gap-2">
      <Icons name="check-circle" size={14} class="text-emerald-600 flex-shrink-0" />
      <span>Resposta rápida em poucos minutos</span>
    </div>
  </div>

</aside>

<!-- Mobile Sticky Bottom Bar (Always Fixed at bottom of viewport) -->
<div class="lg:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-slate-200 px-4 py-3 shadow-[0_-8px_20px_rgba(0,0,0,0.08)]">
  <div class="max-w-md mx-auto flex items-center justify-between gap-3">
    
    <!-- Price info -->
    <div class="flex flex-col">
      <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">A partir de</span>
      <span class="text-sm sm:text-base font-bold font-display text-navy-950">
        {formatCurrency(priceFrom)}
      </span>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 flex-grow justify-end">
      <a
        href="tel:+5551993835822"
        class="p-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-700"
        aria-label="Ligar para Corretora"
      >
        <Icons name="phone" size={18} />
      </a>

      <a
        href={whatsappInquiryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="py-2.5 px-4 rounded-xl bg-whatsapp hover:bg-whatsapp-dark text-white font-bold text-xs shadow-floating flex items-center gap-2"
      >
        <Icons name="whatsapp" size={18} />
        <span>Falar no WhatsApp</span>
      </a>
    </div>

  </div>
</div>
